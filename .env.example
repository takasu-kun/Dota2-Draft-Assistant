# Not needed for the default setup: the dev server proxies "/api" to the
# backend (see vite.config.ts) and the production build calls it relative to
# its own origin (see server/src/app.ts). Set this only to point a
# locally-run frontend at a different API, e.g. a deployed one.
# VITE_API_URL=https://your-deployed-app.onrender.com/api
